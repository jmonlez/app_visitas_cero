        {
          "name": "RouteAdmin",
          "pattern": "admin",
          "target": "TargetAdmin"
        }
      ],
      "targets": {
        "TargetVisitas0": {
          "id": "Visitas0",
          "name": "Visitas0"
        },
        "TargetAdmin": {
          "id": "Admin",
          "name": "Admin"
        }
      }
    },
    "rootView": {
      "viewName": "visitas.cero.visitas0.view.App",
