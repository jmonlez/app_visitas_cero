<mvc:View
    controllerName="visitas.cero.visitas0.controller.Admin"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        id="adminPage"
        title="📊 Registro de visitas">

        <headerContent>
            <Button
                id="btnBack"
                text="⬅ Volver"
                press="onBack" />
        </headerContent>

        <content>

            <VBox id="vboxAdmin" class="vbxTabla">

                <Text
                    id="txtDemo"
                    text="📋 Tabla de visitas (demo)"
                    class="sapUiSmallMarginBottom"/>

                <Table
                    id="tablaVisitas"
                    class="tablaBonita"
                    items="{demo>/visitas}"
                    growing="true">

                    <columns>

                        <Column id="colEmpresa"><Text id="txtEmpresa" text="Empresa"/></Column>
                        <Column id="colDireccion"><Text id="txtDireccion" text="Dirección"/></Column>
                        <Column id="colContacto"><Text id="txtContacto" text="Contacto"/></Column>
                        <Column id="colEmail"><Text id="txtEmail" text="Email"/></Column>
                        <Column id="colResponsable"><Text id="txtResponsable" text="Responsable"/></Column>
                        <Column id="colEmpleado"><Text id="txtEmpleado" text="Empleado"/></Column>

                        <Column id="colFecha"><Text id="txtFecha" text="Fecha"/></Column>
                        <Column id="colInicio"><Text id="txtInicio" text="Inicio"/></Column>
                        <Column id="colFin"><Text id="txtFin" text="Fin"/></Column>

                        <Column id="colLat"><Text id="txtLat" text="Lat"/></Column>
                        <Column id="colLon"><Text id="txtLon" text="Lon"/></Column>

                        <Column id="colObservaciones"><Text id="txtObservaciones" text="Observaciones"/></Column>
                    
                        <Column id="colEliminar"><Text id="txtEliminar" text="Eliminar"/></Column>
                        <Column id="colEditar"><Text id="txtEditar" text="Editar"/></Column>

                        <Column id="colMetadata"><Text id="txtMetadata" text="Última mod."/></Column>

                    </columns>

                    <items>
                        <ColumnListItem id="cliVisita">

                            <cells>

                                <Text id="txtEmp" text="{demo>empresa}" class="empresaCelda"/>
                                <Text id="txtDirec" text="{demo>direccion}" class="normalCelda"/>
                                <Text id="txtCont" text="{demo>contacto}" class="normalCelda"/>
                                <Text id="txtEml" text="{demo>email}" class="normalCelda"/>
                                <Text id="txtResp" text="{demo>responsable}" class="normalCelda"/>
                                <Text id="txtEmpl" text="{demo>empleado}" class="normalCelda"/>

                                <Text id="txtFe" text="{demo>fecha}" class="normalCelda"/>
                                <Text id="txtIn" text="{demo>horaInicio}" class="inicioCelda"/>
                                <Text id="txtFn" text="{demo>horaFin}" class="finCelda"/>

                                <Text id="txtLt" text="{demo>latitud}" class="normalCelda"/>
                                <Text id="txtLn" text="{demo>longitud}" class="normalCelda"/>

                                <Button
                                    id="btnObs"
                                    text="..."
                                    type="Transparent"
                                    press="onOpenObs" />

                                <Button 
                                    id="btnDelete"
                                    icon="sap-icon://delete" 
                                    type="Reject" 
                                    press="onDelete"/>

                                <Button 
                                    id="btnEdit"
                                    icon="sap-icon://edit" 
                                    type="Emphasized" 
                                    press="onEdit"/>

                                <Text id="txtMod" text="Nunca modificado" class="normalCelda"/>

                            </cells>

                        </ColumnListItem>
                    </items>

                </Table>

            </VBox>

        </content>

    </Page>

</mvc:View>